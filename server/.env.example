# 后端配置示例：复制为 .env 后按需修改
PORT=3000
# 初始管理员密码：留空 = 首次启动随机生成，写入 data/INITIAL_ADMIN_PASSWORD.txt（权限 600）。
# 也可在此显式指定，但部署后请立即登录改密并清空本行；仓库中不含任何默认口令。
ADMIN_INITIAL_PASSWORD=
# JWT 签名密钥：留空即可，deploy.sh 首次部署会自动写入 32 字节随机值并持久化。
# 切勿使用可猜测的固定值；留空时服务进程会生成临时随机密钥（重启后 token 失效）。
JWT_SECRET=
# 允许跨域的前端来源：留空 = 不开放 CORS（推荐，nginx 同源反代 /api 无需跨域）。
# 仅当前端与后端分属不同域名时才填写，多个用逗号分隔，例如 https://ap.example.com
# 不要填 *：那等于允许任意站点携带用户 token 调用本 API。
CORS_ORIGINS=
# 附件上传目录（相对 server 根）
UPLOAD_DIR=uploads
# 数据库文件目录
DATA_DIR=data
# 操作日志保留天数，默认 180；填 0 表示永久保留。基线记录始终保留。
# 日志只追加，不提供删除接口；按北京时间每天自动清理一次，清理动作本身也会留痕。
AUDIT_RETENTION_DAYS=180
# 是否记录普通查询类 GET 请求（列表/统计）。默认 0 = 不记录，避免日志暴涨。
# 附件查看、日志导出属于敏感读，无论此值如何都会记录。填 1 则全量记录所有 GET。
AUDIT_LOG_READS=0

# ---- 企业微信群机器人推送（可选，留空则不推送）----
# 在企微群「群设置 → 群机器人 → 添加」获取 Webhook 完整地址。
# 本服务只需能主动出网访问 qyapi.weixin.qq.com，不需要公网入口、域名备案或企业认证。
# ⚠️ 该地址等同「往群里发消息」的权限，切勿写进公开仓库或提交到 git。
# 修改本文件后需重启服务：systemctl restart apartment-admin
WECOM_WEBHOOK_URL=
# 每日待办汇总（7 天内到期 / 逾期 / 待清扫 / 未读提醒）：1 开 / 0 关，默认开。
# 按北京时间整点推送，默认 09:00；当天已推过不会重复，服务晚启动会自动补推。
WECOM_PUSH_DAILY=1
WECOM_PUSH_HOUR=9
# 业务事件即时推送（入住、收款、退房、改到期日、删收款、催租）：1 开 / 0 关，默认开。
WECOM_PUSH_EVENTS=1

# ---- 企业微信智能机器人：群内 @ 查房态（可选）----
# 这是「另一个机器人」，与上面的群机器人 Webhook 不共用凭证，也不影响现有推送。
# 在企微管理后台创建智能机器人 → 开启 API 模式 → 选择「长连接」→ 获取 Bot ID 与 Secret。
# 长连接是服务主动出站（wss），无需公网 IP / 域名备案 / 消息加解密。
# ⚠️ Secret 等同「以机器人身份收发消息」的权限，切勿写进公开仓库。
WECOM_BOT_ID=
WECOM_BOT_SECRET=
# 1 开 / 0 关，默认开；上面两项留空时自动不启动。
WECOM_BOT_ENABLED=1
# 会话白名单（chatid，逗号分隔）：留空 = 不限制。首次联调可从服务日志取到 chatid 后回填收紧。
# 成员白名单（userid，逗号分隔）：留空 = 不限制；非超管创建的机器人 userid 可能是密文。
WECOM_BOT_ALLOWED_CHATS=
WECOM_BOT_ALLOWED_USERS=
# 默认只允许群聊查询；填 1 才允许单聊。
WECOM_BOT_ALLOW_SINGLE=0
# 群里答案是否显示姓名 / 金额 / 水电表读数：填 0 关闭（群成员都能看到）。
# 手机号、身份证、附件无论开关都不查询、不输出。
WECOM_BOT_SHOW_NAME=1
WECOM_BOT_SHOW_RENT=1
WECOM_BOT_SHOW_METER=1
# 未识别的命令是否回一句提示：填 0 则静默忽略，减少打扰。
WECOM_BOT_REPLY_UNKNOWN=1
# 每个会话 60 秒内最多回复几次，默认 10。
WECOM_BOT_RATE_LIMIT=10
# 部署自检：填目标会话 chatid 后，连接成功时主动推一条「已上线」；留空则不推。
WECOM_BOT_TEST_CHAT=
# 仅本地联调：指向模拟企微的 WebSocket 服务（如 ws://127.0.0.1:8788）。生产必须留空。
WECOM_BOT_WS_URL=

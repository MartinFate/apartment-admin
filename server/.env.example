# 后端配置示例：复制为 .env 后按需修改
PORT=3000
# 初始管理员密码：留空 = 首次启动随机生成，写入 data/INITIAL_ADMIN_PASSWORD.txt（权限 600）。
# 也可在此显式指定，但部署后请立即登录改密并清空本行；仓库中不含任何默认口令。
ADMIN_INITIAL_PASSWORD=
# JWT 签名密钥：留空即可，deploy.sh 首次部署会自动写入 32 字节随机值并持久化。
# 切勿使用可猜测的固定值；留空时服务进程会生成临时随机密钥（重启后 token 失效）。
JWT_SECRET=
# 允许跨域的前端来源：留空 = 不开放 CORS（推荐，nginx 同源反代 /api 无需跨域）。
# 仅当前端与后端分属不同域名时才填写，多个用逗号分隔，例如 https://ap.example.com
# 不要填 *：那等于允许任意站点携带用户 token 调用本 API。
CORS_ORIGINS=
# 附件上传目录（相对 server 根）
UPLOAD_DIR=uploads
# 数据库文件目录
DATA_DIR=data
# 操作日志保留天数，默认 180；填 0 表示永久保留。基线记录始终保留。
# 日志只追加，不提供删除接口；按北京时间每天自动清理一次，清理动作本身也会留痕。
AUDIT_RETENTION_DAYS=180
# 是否记录普通查询类 GET 请求（列表/统计）。默认 0 = 不记录，避免日志暴涨。
# 附件查看、日志导出属于敏感读，无论此值如何都会记录。填 1 则全量记录所有 GET。
AUDIT_LOG_READS=0
